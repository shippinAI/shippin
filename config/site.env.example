# Copy this file to /etc/shippin/site.env and keep that copy mode 0600.
# Do not commit the copy. The installer reads it and does not write secrets back here.
#
#   sudo ./install/panel/install.sh --site /etc/shippin/site.env

# Public names for this installation. Use your own DNS names.
SHIPPIN_DOMAIN=example.invalid
SHIPPIN_CONSOLE_HOST=console.example.invalid
# A second origin for the provider panel. Unset serves it from the console host.
# SHIPPIN_OPERATOR_HOST=ops.example.invalid
# SHIPPIN_IDP_ISSUER=https://id.example.invalid
# SHIPPIN_IDP_NAME=Your identity provider
# Spelling of the IdP's reserved scopes, claims and org header. Empty keeps "nomen";
# an issuer running the upstream Zitadel build needs "zitadel".
# SHIPPIN_IDP_DIALECT=zitadel
# Sign-in buttons for upstream providers configured inside the IdP, as id:Label:idp_id.
# SHIPPIN_IDP_PROVIDERS=google:Google:000000000000000000,github:GitHub:000000000000000000
# The IdP org that runs this platform, and the project whose roles are staff and founder roles.
# SHIPPIN_OPERATOR_PLATFORM_ORG_ID=
# SHIPPIN_STAFF_PROJECT_ID=

# The local host agent, when you have installed shippin-hostd. Empty means there is none.
# SHIPPIN_HOSTD_URL=http://127.0.0.1:8444

# Listen address for the panel. 127.0.0.1 keeps it off the public interface until a TLS proxy is in place.
# Use 0.0.0.0:8443 (or the guest address) when a hypervisor port forward reaches the panel directly.
SHIPPIN_LISTEN=127.0.0.1:8080

# TLS. Browsers only keep the Secure session cookie and send writes from an https origin.
# Terminate TLS in a proxy, or let the panel serve it: point at an existing pair (reloaded on change)
# or generate a self-signed pair for SHIPPIN_CONSOLE_HOST.
# SHIPPIN_TLS_CERT=/etc/shippin/tls/panel.crt
# SHIPPIN_TLS_KEY=/etc/shippin/tls/panel.key
# SHIPPIN_TLS=self-signed

# Who can join after the owner: open, invite_only, or waitlist. Empty keeps the JSON default (invite_only).
# SHIPPIN_SIGNUP=waitlist
# Captcha for the public waitlist form: none or turnstile (needs SHIPPIN_CAPTCHA_SECRET).
# SHIPPIN_CAPTCHA_PROVIDER=none

# Sign in through any OIDC provider: Keycloak, Authentik, Google, Nomen, anything with discovery. Register
# this panel with it, with the redirect URL https://<console host>/auth/upstream/callback. Someone invited on
# the Team page signs in with the same verified email and gets the account and roles made for them.
# SHIPPIN_SSO_ISSUER=https://id.example.invalid
# SHIPPIN_SSO_NAME=Your provider
# SHIPPIN_SSO_CLIENT_ID=
# SHIPPIN_SSO_SECRET=

# Selling hosting from this panel: customers, plans and the service catalog. Off by default.
# SHIPPIN_CATALOG_ENABLED=1

# Server enrollment (hostd trading a one-time token for a host credential). Off by default.
# SHIPPIN_SERVERS_ENABLED=1

# Where this panel looks for new builds, shown in the top bar. A fork points this at its own repository.
# Nothing is downloaded or applied; it is one read of a public API. Set to 0 to turn the check off.
# SHIPPIN_UPDATE_ENABLED=1
# SHIPPIN_UPDATE_REPOSITORY=owner/name
# SHIPPIN_UPDATE_BRANCH=main

# Leave these unset to let the installer create a local Postgres database and a session key.
# Set them to bring your own database and key. The database URL is not stored in git.
# SHIPPIN_DATABASE_URL=postgres://shippin:change-me@127.0.0.1:5432/shippin?sslmode=require
# Shared authentication limits. Compose supplies its private Dragonfly by default.
# SHIPPIN_REDIS_URL=rediss://user:password@cache.example.invalid:6379/0
# SHIPPIN_REDIS_PREFIX=shippin:
# SHIPPIN_DRAGONFLY_MAXMEMORY=512mb
# SHIPPIN_DRAGONFLY_THREADS=2
# SHIPPIN_SESSION_KEY=

# The guest this panel runs on, as a hypervisor names it. The panel never stops it as part of a bulk
# stop, and asks first otherwise. Empty uses this machine's hostname, which matches unless they differ.
# SHIPPIN_SELF_GUEST=

# OIDC client id from your identity provider. Empty means the upstream button stays disabled.
# SHIPPIN_OIDC_CLIENT_ID=
# SHIPPIN_NOMEN_ISSUER=https://id.example.invalid
# SHIPPIN_OIDC_CLIENT_SECRET=
# SHIPPIN_OPS_OIDC_CLIENT_ID=
# SHIPPIN_CAPTCHA_SECRET=
# IdP machine-user tokens (tenant onboarding, operator reads, staff team). Prefer writing them
# straight into /etc/shippin/console.env; a re-run keeps values already there.
# SHIPPIN_IDP_SERVICE_TOKEN=
# SHIPPIN_IDP_READ_TOKEN=
# SHIPPIN_IDP_TEAM_TOKEN=
# Disposable installs only. Leave unset on a real site.
# SHIPPIN_MAIL_SINK=

# Hypervisor API tokens go straight into /etc/shippin/console.env as SHIPPIN_HV_<NAME>=secret, then
# restart the console. Name the variable when you add the host. A re-run keeps SHIPPIN_HV_* values.

# SMTP password variable named by mail.password_env in the JSON config. Mail is off in the example JSON.
# SHIPPIN_SMTP_PASSWORD=

# Optional host agent. Leave unset to skip it.
# SHIPPIN_INSTALL_HOSTD=0
# HOSTD_CONFIG=/etc/shippin/hostd.json
