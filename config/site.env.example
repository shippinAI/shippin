# Copy this file to /etc/shippin/site.env and keep that copy mode 0600.
# Do not commit the copy. The installer reads it and does not write secrets back here.
#
#   sudo ./install/panel/install.sh --site /etc/shippin/site.env

# Public names for this installation. Use your own DNS names.
SHIPPIN_DOMAIN=example.invalid
SHIPPIN_CONSOLE_HOST=console.example.invalid
SHIPPIN_OPERATOR_HOST=ops.example.invalid
SHIPPIN_IDP_ISSUER=https://id.example.invalid
SHIPPIN_IDP_NAME=Nomen

# Listen address for the panel. 127.0.0.1 keeps it off the public interface until a TLS proxy is in place.
SHIPPIN_LISTEN=127.0.0.1:8080

# Leave these unset to let the installer create a local Postgres database and a session key.
# Set them to bring your own database and key. The database URL is not stored in git.
# SHIPPIN_DATABASE_URL=postgres://shippin:change-me@127.0.0.1:5432/shippin?sslmode=require
# SHIPPIN_SESSION_KEY=

# OIDC client id from your identity provider. Empty means the upstream button stays disabled.
# SHIPPIN_OIDC_CLIENT_ID=
# SHIPPIN_NOMEN_ISSUER=https://id.example.invalid
# SHIPPIN_OIDC_CLIENT_SECRET=
# SHIPPIN_OPS_OIDC_CLIENT_ID=
# SHIPPIN_CAPTCHA_SECRET=
# Disposable installs only. Leave unset on a real site.
# SHIPPIN_MAIL_SINK=

# SMTP password variable named by mail.password_env in the JSON config. Mail is off in the example JSON.
# SHIPPIN_SMTP_PASSWORD=

# Optional host agent. Leave unset to skip it.
# SHIPPIN_INSTALL_HOSTD=0
# HOSTD_CONFIG=/etc/shippin/hostd.json
