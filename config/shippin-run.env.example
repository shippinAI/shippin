# Copy to the host environment file and fill the empty values there.
# Do not commit the filled file.
SHIPPIN_RUN_STATE_DIR=/var/lib/shippin-run
SHIPPIN_RUN_CONFIG=/etc/shippin-run/shippin-run.json
SHIPPIN_RUN_LISTEN=:8080
SHIPPIN_RUN_API_TOKEN=
SHIPPIN_RUN_FREE_MINUTES=3000
SHIPPIN_RUN_GITHUB_APP_ID=
SHIPPIN_RUN_GITHUB_APP_SLUG=
SHIPPIN_RUN_GITHUB_PRIVATE_KEY_FILE=
SHIPPIN_RUN_GITHUB_INSTALLATION_ID=
SHIPPIN_RUN_GITHUB_WEBHOOK_SECRET=
SHIPPIN_RUN_PROVISIONER=none
SHIPPIN_RUN_PROXMOX_API_URL=
SHIPPIN_RUN_PROXMOX_TOKEN=
SHIPPIN_RUN_PROXMOX_NODE=
