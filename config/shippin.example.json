      {
        "id": "grok",
        "label": "Grok",
        "vendor": "xAI \u00b7 Grok Build",
        "token_label": "xAI API key",
        "token_hint": "An xai-\u2026 key from console.x.ai.",
        "token_url": "https://console.x.ai",
        "vaultix_key": "XAI_API_KEY",
        "browser_note": "Device code: open the x.ai link and enter the code."
      }
    ]
  },
