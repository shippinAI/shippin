  },
  "onboarding": {
    "enabled": true,
    "plan": "free"
  },
  "operator": {
    "role": "op_superadmin",
    "host": "ops.example.invalid",
    "client_id": "",
    "origin_only": false,
    "member_limit": 200,
    "platform_org_id": "",
    "cert_hosts": [
      "console.example.invalid",
      "id.example.invalid"
    ],
    "admin_hosts": []
  },
  "staff": {
    "project_id": "",
    "org_id": "",
    "mode": "",
    "cache_seconds": 30,
    "session": {
      "minutes": 60,
      "reauth_minutes": 5,
      "required": true
    }
  },
  "roles": {
    "iam": [
      {
        "from": "IAM_OWNER",
        "to": "op_superadmin"
      },
      {
        "from": "IAM_ORG_MANAGER",
        "to": "op_admin"
      },
      {
        "from": "IAM_USER_MANAGER",
        "to": "op_admin"
      },
      {
        "from": "IAM_INFRA",
        "to": "op_infra"
      }
    ],
    "iam_default": "op_support",
    "org": [
      {
        "from": "ORG_OWNER",
        "to": "org_owner"
      },
      {
        "from": "ORG_USER_MANAGER",
        "to": "org_admin"
      },
      {
        "from": "ORG_ADMIN",
        "to": "org_admin"
      }
    ],
    "member": "org_member",
    "owner": "org_owner",
    "managers": [
      "org_owner",
      "org_admin"
    ],
    "infra": "op_infra"
  },
  "access": {
    "durations": [
      "1h",
      "4h",
      "24h"
    ],
    "reason_min": 10,
    "reason_max": 500,
    "sweep_seconds": 30,
    "log_window": "10m",
    "break_glass": {
      "duration": "1h",
      "reauth_minutes": 10,
      "justification_min": 20,
      "notice_hours": 168,
      "categories": [
        {
          "id": "security_incident",
          "label": "Security incident"
        },
        {
          "id": "legal_abuse",
          "label": "Legal / abuse report"
        },
        {
          "id": "service_outage",
          "label": "Service outage"
        },
        {
          "id": "legal_hold",
          "label": "Legal hold (court order)",
          "withhold_notice": true,
          "notice_delay": "720h"
        }
      ]
    }
  },
  "mail": {
    "enabled": false,
    "host": "",
    "port": 465,
    "tls": "implicit",
    "server_name": "",
    "ca_file": "",
    "from": "notices@example.invalid",
    "from_name": "Shippin",
    "username": "",
    "password_env": "SHIPPIN_SMTP_PASSWORD",
    "max_attempts": 8,
    "retry_base_seconds": 60,
    "retry_max_seconds": 3600,
    "poll_seconds": 10,
    "batch_size": 20,
    "timeout_seconds": 20
  },
  "jobs": {
    "enabled": false,
    "workers": 4,
    "max_attempts": 5,
    "lease_seconds": 60,
    "heartbeat_seconds": 20,
    "poll_seconds": 2,
    "backoff_seconds": 10,
    "backoff_max_seconds": 300,
    "reconcile_seconds": 60,
    "drift_seconds": 600,
    "keep_days": 30,
    "idempotency_hours": 24,
    "provision_planned_boundaries": false
  },
  "ai": {
    "enabled": false,
    "providers": [
      {
        "id": "claude",
        "label": "Claude Code",
        "vendor": "Anthropic",
        "login_command": "claude auth login"
      },
      {
        "id": "codex",
        "label": "Codex",
        "vendor": "OpenAI",
        "login_command": "codex login --device-auth",
        "device_url": "https://auth.openai.com/codex/device"
      },
      {
        "id": "grok",
        "label": "Grok CLI",
        "vendor": "xAI",
        "login_command": "grok login --device-auth"
      }
    ],
    "idle_minutes": 15,
    "touch_seconds": 60,
    "tenants": [],
    "egress_hosts": [
      "api.anthropic.com",
      "claude.ai",
      "console.anthropic.com",
      "auth.openai.com",
      "api.openai.com",
      "chatgpt.com",
      "auth.x.ai",
      "cli-chat-proxy.grok.com",
      "registry.npmjs.org"
    ],
    "terms_note": "You sign in with your own subscription; its vendor's terms apply to your use."
  },
  "github": {
    "enabled": false,
    "app_slug": "shippin",
    "api_base": "https://api.github.com",
    "web_base": "https://github.com",
    "tenants": [],
    "refresh_minutes": 45,
    "poll_minutes": 10,
    "state_minutes": 15,
    "max_repos": 500,
    "token_permissions": {
      "contents": "write",
      "metadata": "read",
      "pull_requests": "write",
      "workflows": "write"
    }
  },
  "prompt": {
    "enabled": false,
    "tenants": [],
    "max_bytes": 8192,
    "agents": [
      "claude",
      "codex"
    ],
    "stacks": [
      {
        "template": "python",
        "label": "Python",
        "keywords": [
          "python",
          "flask",
          "fastapi",
          "django",
          "scraper",
          "notebook",
          "ml"
        ]
      },
      {
        "template": "go",
        "label": "Go",
        "keywords": [
          "golang",
          "in go",
          "go cli",
          "go api",
          "go service",
          "grpc"
