        "token_hint": "A fine-grained or classic PAT (ghp_\u2026 or github_pat_\u2026).",
        "token_url": "https://github.com/settings/tokens",
        "vaultix_key": "GITHUB_TOKEN",
        "browser_note": "Device code: open github.com/login/device and enter the code."
      },
      {
        "id": "claude",
        "label": "Claude",
        "vendor": "Anthropic \u00b7 Claude Code",
        "token_label": "Claude Code OAuth token",
        "token_hint": "Run `claude setup-token` on any machine and paste the sk-ant-oat01-\u2026 token.",
        "token_url": "https://docs.anthropic.com/en/docs/claude-code/setup",
        "vaultix_key": "CLAUDE_CODE_OAUTH_TOKEN",
        "browser_note": "Sign in on claude.com, then paste the code it shows back here."
      },
      {
        "id": "codex",
        "label": "Codex",
        "vendor": "OpenAI \u00b7 Codex CLI",
        "token_label": "OpenAI API key",
        "token_hint": "An sk-\u2026 key from platform.openai.com.",
        "token_url": "https://platform.openai.com/api-keys",
        "vaultix_key": "OPENAI_API_KEY",
        "browser_note": "Device code: open auth.openai.com/codex/device and enter the code."
