    "template_seed": "/etc/shippin/templates.json",
    "preview_min": 1024,
    "preview_max": 65535,
    "image_prefix": "shippin/",
    "sizes": [
      {
        "id": "small",
        "label": "Small",
        "cpu": 2,
        "memory_gib": 4,
        "disk_gib": 20
      },
      {
        "id": "medium",
        "label": "Medium",
        "cpu": 4,
        "memory_gib": 8,
        "disk_gib": 40
      },
      {
        "id": "large",
        "label": "Large",
        "cpu": 8,
        "memory_gib": 16,
        "disk_gib": 80
      }
    ],
    "port_max": 22999,
    "repo_hosts": [
      "github.com",
      "gitlab.com",
      "codeberg.org"
    ],
    "reserved_ports": [
      22,
      80,
      443
    ],
    "reserved_domains": [
      "example.invalid"
    ],
    "template_limits": {
      "max_cpu": 32,
      "max_memory_gib": 128,
      "min_disk_gib": 5,
      "max_disk_gib": 1024,
      "max_ports": 10,
      "max_startup_bytes": 16384
