# Optional rrflow rollout tenants. shippin.json keeps services.rrflow.tenants empty and
# listed_only true, so an empty list enables nobody. The console appends these ids at startup
# (internal/config/env.go). pa-pb-rev1's tenant is configuration, not a value compiled into the tree.
SHIPPIN_RRFLOW_TENANTS=00000000-0000-4000-8000-000000000001
