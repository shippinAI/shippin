// One shell tab plus Zellij's compact status bar (key hints for new users). shippin-term names
// the shell tab after the workspace in a copy of this file, so keep that tab's name line as is.
layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
    }
    tab name="shell" focus=true {
        pane
    }
}
