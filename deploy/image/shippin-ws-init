#!/bin/sh
# Baked into the Shippin dev image. Called by shippin-hostd after the home volume is attached.
# Reads authorized_keys from stdin; ensures the dev user's home exists on the volume.
set -eu
U=dev
# Test for .profile, not the directory: an attached AI home (/home/dev/.ai) creates /home/dev first.
if [ ! -e /home/$U/.profile ]; then mkdir -p /home/$U && cp -a /etc/skel/. /home/$U/; fi
mkdir -p /home/$U/.ssh /home/$U/code
cat > /home/$U/.ssh/authorized_keys
chmod 700 /home/$U/.ssh && chmod 600 /home/$U/.ssh/authorized_keys
chown -R $U:$U /home/$U
