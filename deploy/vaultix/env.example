# Copy to .env next to compose.yaml. No secrets here: they live in $VAULTIX_SECRETS_DIR (0700),
# rendered from sops by secrets-render.sh.
VAULTIX_IMAGE=docker.io/infisical/infisical@sha256:065de1e37b091f2ca1a38bd88c54e16583547379aede4c8c9244074f51b0aa50
VAULTIX_PG_IMAGE=docker.io/library/postgres:16-alpine
VAULTIX_REDIS_IMAGE=docker.io/library/redis:7-alpine
VAULTIX_BIND=127.0.0.1
VAULTIX_API_PORT=18480
VAULTIX_PG_PORT=15432
VAULTIX_REDIS_PORT=16379
VAULTIX_PG_USER=vaultix
VAULTIX_PG_DB=vaultix
VAULTIX_SITE_URL=https://secrets.example.invalid
VAULTIX_SECRETS_DIR=./secrets
VAULTIX_ADMIN_EMAIL=vaultix-admin@example.invalid
