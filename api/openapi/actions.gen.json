  "paths": {
    "/me/identity/access-keys": {
      "get": {
        "operationId": "shippin.identity.access_key.list",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "items": {
                      "items": {
                        "$ref": "#/components/schemas/AccessKey"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "items"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Done."
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "accessKey": []
          }
        ],
        "summary": "List your access keys, with when each expires and was last used.",
        "tags": [
          "identity"
        ],
        "x-mcpl": {
          "access": "signed-in",
          "id": "shippin.identity.access_key.list",
          "reason": false,
          "risk": "read"
        }
      },
      "post": {
        "operationId": "shippin.identity.access_key.create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/AccessKeyCreateInput"
                  },
                  {
                    "properties": {
                      "reason": {
                        "description": "Why this change is being made; kept in the audit log with it.",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  }
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessKeyCreated"
                }
              }
            },
            "description": "Created."
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "accessKey": []
          }
        ],
        "summary": "Make an access key an AI client or script uses to act as you; it is shown once.",
        "tags": [
          "identity"
        ],
        "x-mcpl": {
          "access": "signed-in",
          "event": "shippin.identity.access_key.created",
          "id": "shippin.identity.access_key.create",
          "reason": false,
          "risk": "write"
        }
      }
    },
    "/me/identity/access-keys/{accessKeyId}": {
      "delete": {
        "operationId": "shippin.identity.access_key.revoke",
        "parameters": [
          {
            "in": "path",
            "name": "accessKeyId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "reason": {
                    "description": "Why this change is being made; kept in the audit log with it.",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": false
        },
        "responses": {
          "204": {
            "description": "Done."
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "accessKey": []
          }
        ],
        "summary": "Revoke one of your access keys; whatever uses it stops at once.",
        "tags": [
          "identity"
        ],
        "x-mcpl": {
          "access": "signed-in",
          "event": "shippin.identity.access_key.revoked",
          "id": "shippin.identity.access_key.revoke",
          "reason": false,
          "risk": "destructive"
        }
      }
    },
