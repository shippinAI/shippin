---
import "../styles/site.css";
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href="/fonts/source-sans-3-latin-400.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <div class="wrap">
      <header class="nav">
        <a class="brand" href="/">Shippin Run</a>
        <nav class="nav-links" aria-label="Site">
          <a href="/#compare">Compare</a>
          <a href="/mcp/">MCP</a>
          <a href="/operators/">Operators</a>
        </nav>
      </header>
      <main id="content">
        <slot />
      </main>
      <footer class="foot">
        <p>Shippin Run. Guest creation is not implemented in this build.</p>
        <nav class="foot-links" aria-label="Footer">
          <a href="/llms.txt">llms.txt</a>
          <a href="/fonts/OFL.txt">Font license</a>
        </nav>
      </footer>
    </div>
    <script type="module" src="/scripts/boot.js"></script>
  </body>
</html>
