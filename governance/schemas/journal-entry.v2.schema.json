{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shippin.cloud/schemas/work-journal-entry/v2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "plan_id", "timestamp", "actor", "state", "summary", "step_results", "results", "next"],
  "properties": {
    "schema_version": {"const": "2"},
    "plan_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "actor": {"type": "string", "minLength": 1},
    "state": {"enum": ["started", "in_progress", "blocked", "handoff", "complete"]},
    "summary": {"type": "string", "minLength": 1},
    "step_results": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["step_id", "status", "detail"],
        "properties": {
          "step_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["done", "blocked", "in_progress"]},
          "detail": {"type": "string", "minLength": 1},
          "evidence": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["check_id", "status", "detail"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "failed", "skipped"]},
          "detail": {"type": "string", "minLength": 1},
          "evidence": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "next": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
