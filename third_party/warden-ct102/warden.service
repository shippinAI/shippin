[Unit]
Description=Warden Server Management Panel
Documentation=https://github.com/eonsofstupidity/wardenclyffe/warden
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/warden
Restart=on-failure
RestartSec=5

User=root
Group=root
Environment=HOME=/root

EnvironmentFile=-/etc/warden/warden.env
EnvironmentFile=-/run/warden/runtime.env
ExecStartPre=-/usr/local/bin/warden-infisical-env-refresh /run/warden/runtime.env

ProtectSystem=false
ProtectHome=false
NoNewPrivileges=no
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=warden

TimeoutStopSec=10
KillMode=process
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
