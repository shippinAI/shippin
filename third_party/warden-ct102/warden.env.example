# Warden configuration
# Loaded by /etc/systemd/system/warden.service via EnvironmentFile
# Copy to /etc/warden/warden.env on the host running warden, fill real values.
# Optional overlay: /run/warden/runtime.env (generated by warden-infisical-env-refresh).

# --- Server ---
# PORT=9006
# TLS=true
# TLS_CERT=/etc/warden/tls/cert.pem
# TLS_KEY=/etc/warden/tls/key.pem

# --- Dashboard platform registry (optional override for dev) ---
# WARDEN_STATE_DIR=/var/lib/warden

# --- Proxmox connector ---
# Mint a scoped token: pveum user token add <user>@pve <name> --privsep 0
# Grant role: pveum acl modify / -user <user>@pve -token <name> -role <role>
PROXMOX_HOST=
PROXMOX_PORT=8006
PROXMOX_NODE=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_VERIFY_TLS=true

# --- Estate / full backups ---
# Optional S3-compatible backup destination. Set these on the host. Never commit live values.
# Keys are loaded from Infisical (or these env vars). Never commit live values.
# SHIPPIN_S3_ENDPOINT=https://s3.example.invalid
# SHIPPIN_S3_REGION=us-east-1
# SHIPPIN_S3_BUCKET=
# SHIPPIN_S3_PREFIX=shippin/estate
# SHIPPIN_S3_ACCESS_KEY=
# SHIPPIN_S3_SECRET_KEY=
# WARDEN_STORAGE_PATH=/srv/warden/storage
# WARDEN_OPERATOR_HOME=/home/wardenop

# --- Infisical runtime export (recommended for persistent automation) ---
# Use Universal Auth by default. Keep this file 0600 and root-owned.
# The refresh helper can export dotenv values into /run/warden/runtime.env.
# INFISICAL_API_URL=https://app.infisical.com
# INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
# INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
# INFISICAL_PROJECT_ID=
# INFISICAL_ENV=prod
# INFISICAL_PATH=/
# Break-glass fallback only:
# INFISICAL_TOKEN=