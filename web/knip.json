{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.tsx",
    "src/ops-main.tsx",
    "src/launcher-main.tsx",
    "src/routes/**/{page,layout,meta,mounts}.{ts,tsx}",
    "src/modules/*/routes/**/{page,layout,meta,mounts}.{ts,tsx}",
    "src/**/*.test.ts",
    "scripts/**/*.mjs"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.mjs"
  ],
  "ignoreDependencies": [
    "@biomejs/biome",
    "tailwindcss-react-aria-components"
  ],
  "ignore": [
    "src/app/*.gen.ts"
  ]
}
