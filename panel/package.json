{
  "name": "shippin-control-panel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate:openapi-index": "node ./scripts/generate-openapi-index.mjs",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node ./scripts/check-boundaries.mjs",
    "test": "node --test ./scripts/check-boundaries.test.mjs ./scripts/settings.test.mjs ./scripts/oidc.test.mjs ./scripts/workbench-operations.test.mjs",
    "dev": "npm run generate:openapi-index && vite",
    "build": "npm run typecheck && npm run check:boundaries && npm run generate:openapi-index && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "js-yaml": "^4.1.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
