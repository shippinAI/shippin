[Unit]
Description=Shippin agent terminal (ttyd attached to the build agent's tmux session)
After=network-online.target

[Service]
User=dev
WorkingDirectory=/home/dev
Environment=HOME=/home/dev
# shippin-hostd writes AGENT_TERM_PORT, AGENT_TERM_IFACE, AGENT_TERM_BASE and AGENT_SESSION here.
EnvironmentFile=/etc/default/shippin-agent-term
ExecStart=/usr/bin/ttyd -W -i ${AGENT_TERM_IFACE} -p ${AGENT_TERM_PORT} -b ${AGENT_TERM_BASE} tmux new -A -s ${AGENT_SESSION}
Restart=on-failure

[Install]
WantedBy=multi-user.target
