<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width">
<meta name="color-scheme" content="light dark"><title>{{.Subject}}</title></head>
<body style="margin:0;padding:0;background:#f4f4f6;font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:#18181b">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f4f6;padding:32px 12px"><tr><td align="center">
<table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;background:#ffffff;border:1px solid #e4e4e7;border-radius:12px">
<tr><td style="padding:24px 28px 0 28px">
<table role="presentation" cellpadding="0" cellspacing="0"><tr>
<td style="width:28px;height:28px;border-radius:7px;background:linear-gradient(135deg,#5ec8ff,#7c5cff)"></td>
<td style="padding-left:10px;font-size:15px;font-weight:600;letter-spacing:-0.01em">{{.Brand}}</td></tr></table>
</td></tr>
<tr><td style="padding:20px 28px 4px 28px">
<h1 style="margin:0 0 10px 0;font-size:20px;line-height:28px;font-weight:600;letter-spacing:-0.01em{{if .Alert}};color:#b91c1c{{end}}">{{.Heading}}</h1>
<p style="margin:0;font-size:14px;line-height:22px;color:#3f3f46">{{.Intro}}</p>
</td></tr>
{{if .Facts}}<tr><td style="padding:16px 28px 0 28px">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #e4e4e7;border-radius:8px">
{{range $i, $f := .Facts}}<tr><td style="padding:9px 12px;font-size:13px;color:#71717a;width:34%;{{if $i}}border-top:1px solid #f0f0f2;{{end}}">{{index $f 0}}</td>
<td style="padding:9px 12px;font-size:13px;color:#18181b;{{if $i}}border-top:1px solid #f0f0f2;{{end}}">{{index $f 1}}</td></tr>
{{end}}</table></td></tr>{{end}}
{{if .URL}}<tr><td style="padding:22px 28px 0 28px">
<a href="{{.URL}}" style="display:inline-block;background:#18181b;color:#ffffff;text-decoration:none;font-size:14px;font-weight:500;padding:10px 16px;border-radius:8px">{{.Action}}</a>
</td></tr>{{end}}
<tr><td style="padding:24px 28px 24px 28px"><p style="margin:0;font-size:12px;line-height:18px;color:#a1a1aa">{{.Footer}}</p></td></tr>
</table></td></tr></table></body></html>
